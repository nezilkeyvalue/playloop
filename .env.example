# .env.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Leave ALL of these unset for a zero-external-accounts local run: the db layer
# falls back to an on-disk JSON store under ./dev-data/, blob storage falls back
# to ./dev-data/blob/, and the app runs with no login wall and one implicit
# account. Fill them in to use real Postgres + Storage + Google SSO.
#
# Server-only (service role bypasses RLS — the API routes are the trust
# boundary; see lib/db/client.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-visible. BOTH of these are required for auth/login to appear at all
# (lib/auth/config.ts#isAuthEnabled) — with them unset the app renders no login
# button and every route keeps working against the implicit dev account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage bucket for sprites and manual uploads. Created by
# supabase/migrations/*_auth_and_storage.sql — don't create it by hand.
SUPABASE_STORAGE_BUCKET=sprites

# --- Google SSO -------------------------------------------------------------
# Read by `supabase config push`, which promotes supabase/config.toml (including
# the [auth.external.google] block) to the linked project. Never committed.
#
# From a Google Cloud OAuth 2.0 Client of type "Web application". Its
# "Authorized redirect URI" must be the SUPABASE callback, not ours:
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Blob -------------------------------------------------------------------
# Unused. Sprite storage is Supabase Storage (see lib/storage.ts); this is kept
# only so an existing deployment that still sets it doesn't look misconfigured.
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---------------------------------------------------------
# Injected by the marketplace integration, not set by hand:
#   vercel integration add resend/resend-email -m domain=<yours> -m region=us-east-1
# Leave unset locally: lib/email/send.ts#isEmailEnabled() is then false and
# lead capture degrades to "we saved your address" instead of erroring.
# Sending also requires the domain to be VERIFIED in Resend (DNS records).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# --- Gemini -----------------------------------------------------------------
# Leave unset to use the deterministic templated-copy fallback (lib/engine/brain.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FETCH_TIMEOUT_MS=10000
IMAGE_TIMEOUT_MS=5000
MAX_CANDIDATE_IMAGES=12
SPRITE_SIZE=256
MIN_ASSETS_FOR_AUTO=4
