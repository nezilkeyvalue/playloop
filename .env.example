# .env.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave Supabase vars unset for local/dev — the db layer falls back to an
# in-memory + on-disk (./dev-data) store automatically so you can run the
# whole app with zero external accounts. Fill these in to use real Postgres.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave unset to fall back to local filesystem storage under ./dev-data/blob
# (dev only — Vercel has no persistent filesystem, this path does not work in prod).
BLOB_READ_WRITE_TOKEN=

# Leave unset to use the deterministic templated-copy fallback (see lib/engine/brain.ts).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

FETCH_TIMEOUT_MS=10000
IMAGE_TIMEOUT_MS=5000
MAX_CANDIDATE_IMAGES=12
SPRITE_SIZE=256
MIN_ASSETS_FOR_AUTO=4
