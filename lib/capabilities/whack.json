{
  "version": 1,
  "id": "whack",
  "name": "Whack-a-Mole",
  "summary": "Products pop out of holes in a grid; tap them before they duck back down. Avoid the decoys.",

  "roles": [
    {
      "id": "mole",
      "purpose": "Products that pop up and duck back down for the player to tap",
      "count": { "min": 3, "ideal": 6, "max": 10 },
      "requires": {
        "subjectTypeIn": ["product", "lifestyle", "unknown"],
        "minShortEdge": 200,
        "aspectRange": [0.5, 2.0],
        "maxTextDensity": 0.2,
        "maxSubjectCount": 1
      },
      "prefers": {
        "distinctPhash": true,
        "coverageRange": [0.25, 0.85],
        "uniformScale": true,
        "contrastAgainst": "stage.background"
      },
      "transforms": ["trim", "padSquare", "resize"],
      "fallback": "none"
    },
    {
      "id": "hazard",
      "purpose": "Decoys that cost points if tapped",
      "count": { "min": 0, "ideal": 2, "max": 4 },
      "requires": { "isolatable": true },
      "transforms": ["cutout", "trim", "padSquare", "desaturate"],
      "fallback": "generatedShape",
      "optional": true
    },
    {
      "id": "stageBackground",
      "purpose": "Play area backdrop",
      "count": { "min": 0, "ideal": 1, "max": 1 },
      "requires": { "subjectTypeIn": ["lifestyle", "pattern"] },
      "transforms": ["cropAspect", "blur", "darken", "resize"],
      "fallback": "brandGradient",
      "optional": true
    }
  ],

  "data": {
    "required": [],
    "optional": ["name", "priceMinor"]
  },

  "placements": {
    "section": { "minWidth": 320, "minHeight": 420, "preferredAspect": 0.85 },
    "fullpage": { "minWidth": 320, "minHeight": 480, "preferredAspect": 0.7 },
    "modal": { "minWidth": 300, "minHeight": 400, "preferredAspect": 0.85 },
    "ad": { "sizes": ["300x250", "320x480", "300x600"], "excluded": ["728x90"] }
  },

  "tuning": {
    "holeCount": { "min": 4, "default": 7, "max": 9 },
    "popRateHz": { "min": 0.6, "default": 1.1, "max": 2.5 },
    "upTimeSec": { "min": 0.5, "default": 0.9, "max": 1.6 },
    "durationSec": { "min": 20, "default": 35, "max": 60 },
    "hazardRatio": { "min": 0, "default": 0.2, "max": 0.4 }
  },

  "scoring": {
    "maxRealistic": 1040,
    "rewardTierHint": [0.3, 0.65]
  },

  "cost": { "buildMs": 350, "runtimeKb": 30 }
}
